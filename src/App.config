<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <connectionStrings>
    <add name="eDelphyn" connectionString="Data Source=localhost;Initial Catalog=eDelphyn;Integrated Security=True;Connect Timeout=8;Application Name=eDelphyn Hemograma" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Nombre de prueba|Seleccionada al iniciar (true/false). Separar con ;. Reiniciar después de editar. Máximo 32 pruebas. -->
    <add key="Hemograma.Pruebas" value="Rcto. PQ|true;Rcto. Leu|true;Neutrófilos|true;Linfocitos|true;Monocitos|true;Eosinófilos|true;Basófilos|true;Hto|true;Hb|false" />
  </appSettings>
</configuration>
