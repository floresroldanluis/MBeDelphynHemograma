<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <connectionStrings>
    <add name="eDelphyn" connectionString="Data Source=localhost;Initial Catalog=eDelphyn;Integrated Security=True;Connect Timeout=8;Application Name=eDelphyn Hemograma" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- ID_TEST|Nombre visible|Seleccionada al iniciar (true/false). Separar con ;. Reiniciar después de editar. Máximo 32 pruebas. -->
    <add key="Hemograma.Pruebas" value="72|Rcto. PQ|true;73|Rcto. Leu|true;74|Neutrófilos|true;75|Linfocitos|true;76|Monocitos|true;77|Eosinófilos|true;78|Basófilos|true;92|Hto|true;93|Hb|false" />
  </appSettings>
</configuration>
